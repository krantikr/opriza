# ---------------------------------------------------------------------------
# AI Sales Quotation Copilot - environment configuration
# Copy to `.env` and fill in the placeholder values.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="AI Sales Quotation Copilot"
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Company identity (used in generated quotation drafts) ----------------
COMPANY_NAME="Your Steel Trading Company"
COMPANY_EMAIL=saurabh.cegian@gmail.com
COMPANY_PHONE="+91 7845718662"
COMPANY_SIGNATORY="Sales Team"

# --- Database -------------------------------------------------------------
# SQLite for the MVP. Swap to a PostgreSQL URL later without code changes.
DATABASE_URL=sqlite:///data/app.db

# --- LLM via OpenRouter ---------------------------------------------------
# PLACEHOLDER: paste your OpenRouter key here before running the AI layer.
# Everything except the AI steps works with this left empty.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers (safe to leave as-is).
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE="AI Sales Quotation Copilot"

# Per-task model routing. Classification runs on every inbound email, so it
# should use a cheaper/faster model than extraction and drafting.
LLM_MODEL_CLASSIFY=openai/gpt-4o-mini
LLM_MODEL_EXTRACT=anthropic/claude-sonnet-4.5
LLM_MODEL_DRAFT=anthropic/claude-sonnet-4.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# --- Email source ---------------------------------------------------------
# "local"  -> read .eml files from data/sample/emails (no credentials needed)
# "gmail"  -> read from the connected Gmail account via OAuth
EMAIL_SOURCE=local
LOCAL_EMAIL_DIR=data/sample/emails

# --- Gmail OAuth ----------------------------------------------------------
# PLACEHOLDER: download "Desktop app" OAuth client credentials from your
# Google Cloud project and save the JSON to the path below, then run:
#     uv run python scripts/gmail_auth.py
# Least-privilege scopes: gmail.readonly + gmail.send only.
GMAIL_CREDENTIALS_FILE=data/secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=data/secrets/gmail_token.json
GMAIL_QUERY="in:inbox -in:chats newer_than:7d"
GMAIL_MAX_RESULTS=25

# --- Polling --------------------------------------------------------------
POLLING_ENABLED=false
POLLING_INTERVAL_SECONDS=120

# --- Safety ---------------------------------------------------------------
# MVP guardrail (spec Rule 4). Sending always requires a recorded human
# approval; there is no code path that bypasses it.
AUTO_SEND_ENABLED=false
