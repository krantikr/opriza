# ---------------------------------------------------------------------------
# AI Sales Quotation Copilot - environment configuration
# Copy to `.env` and fill in the placeholder values.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="AI Sales Quotation Copilot"
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Company identity (used in generated quotation drafts) ----------------
COMPANY_NAME="Your Steel Trading Company"
# Printed under the company name on the quotation table. Leave blank to omit.
COMPANY_TAGLINE=""
COMPANY_EMAIL=saurabh.cegian@gmail.com
COMPANY_PHONE="+91 7845718662"
COMPANY_SIGNATORY="Sales Team"

# --- Database -------------------------------------------------------------
# SQLite for the MVP. Swap to a PostgreSQL URL later without code changes.
DATABASE_URL=sqlite:///data/app.db

# --- LLM via OpenRouter ---------------------------------------------------
# PLACEHOLDER: paste your OpenRouter key here before running the AI layer.
# Everything except the AI steps works with this left empty.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers (safe to leave as-is).
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_TITLE="AI Sales Quotation Copilot"

# Per-task model routing. Classification runs on every inbound email, so it
# should use a cheaper/faster model than extraction and drafting.
LLM_MODEL_CLASSIFY=openai/gpt-4o-mini
LLM_MODEL_EXTRACT=anthropic/claude-sonnet-4.5
LLM_MODEL_DRAFT=anthropic/claude-sonnet-4.5

# One model standing behind every task above. Used only when the task's own
# model cannot be reached at all - retired, unknown, or no longer permitted.
# Pick something widely available and cheap: its job is to keep the desk
# running through an outage, not to match the primary model's quality.
# Set to an empty value to disable falling back.
LLM_MODEL_FALLBACK=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# --- Email source ---------------------------------------------------------
# "local"  -> read .eml files from data/sample/emails (no credentials needed)
# "gmail"  -> read from the connected Gmail account via OAuth
EMAIL_SOURCE=local
LOCAL_EMAIL_DIR=data/sample/emails

# --- Gmail OAuth ----------------------------------------------------------
# PLACEHOLDER: download "Desktop app" OAuth client credentials from your
# Google Cloud project and save the JSON to the path below, then run:
#     uv run python scripts/gmail_auth.py
# Least-privilege scopes: gmail.readonly + gmail.send only.
GMAIL_CREDENTIALS_FILE=data/secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=data/secrets/gmail_token.json
GMAIL_QUERY="in:inbox -in:chats newer_than:7d"
GMAIL_MAX_RESULTS=25

# --- Polling --------------------------------------------------------------
# Master switch for the background mail poller. With this off nothing is
# fetched on a timer at all, whatever each desk's schedule says - use
# POST /api/v1/pipeline/run to pull once by hand.
POLLING_ENABLED=false
# How often the poller wakes to *consider* every desk. It is not the checking
# frequency: each desk is checked on its own crawl window (Settings -> Mail
# checking), so this only bounds how precisely those windows are honoured.
POLL_TICK_SECONDS=60
# Shared secret for the external cron trigger (POST /api/v1/pipeline/cron).
# On a free host that sleeps when idle, leave POLLING_ENABLED=false and let an
# external cron (GitHub Actions / cron-job.org) call that endpoint on a
# schedule instead. The caller must send this value in the X-Cron-Secret
# header. Empty = the endpoint is disabled (503). Generate a long random value.
CRON_SECRET=

# --- Safety ---------------------------------------------------------------
# MVP guardrail (spec Rule 4). Sending always requires a recorded human
# approval; there is no code path that bypasses it.
AUTO_SEND_ENABLED=false

# --- Push notifications (Firebase Cloud Messaging) --------------------------
# The only channel that reaches a trader with the site closed. Leave blank and
# push simply stays inactive - nothing breaks, and the Settings page says so.
#
# Backend (sending). From Firebase console > Project settings > Service
# accounts > "Generate new private key". Keep the JSON out of git.
FCM_PROJECT_ID=tdesk-8a1b2
FCM_CREDENTIALS_FILE=data/secrets/fcm.json

# Frontend (receiving). From Firebase console > Project settings > General >
# "Your apps" > Web app config. These are public by design - they identify the
# project, they do not authorise sending.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=tdesk-8a1b2
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging > Web Push certificates > "Key pair".
VITE_FIREBASE_VAPID_KEY=

# --- Oprisa agents (/app) ----------------------------------------------------
# See docs/agents/RUNBOOK.md. Everything here has a safe default.
#
# How the agents think: rules (no model calls), llm (OpenRouter, with rules as
# the fallback and as the check on every answer), or auto = llm when
# OPENROUTER_API_KEY above is a real key, else rules.
AGENT_BRAIN=auto
# Models for the llm brain: FAST reads enquiries and routes questions,
# WRITE words messages and answers. Any OpenRouter model id; blank falls back
# to LLM_MODEL_CLASSIFY / LLM_MODEL_DRAFT above.
AGENT_MODEL_FAST=
AGENT_MODEL_WRITE=
#
# Where messages to customers and suppliers go: outbox (stored, written to
# data/sent/agents/, nothing leaves) or live (email through the existing
# sender, SMS through the webhook below). Within the owner's rules, live
# agents send without asking per message - that is the product. Start on
# outbox and switch only once a desk's rules are set.
AGENT_CHANNEL=outbox
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
#
# Base address for the links in messages (/l/<token>): the public frontend.
APP_PUBLIC_URL=http://localhost:5173
#
# Run due agent jobs and events every 5 minutes inside the API process. Leave
# off when cron runs scripts/agents_tick.py instead.
AGENTS_SCHEDULER=off
